+        self.assertEqual(summary["pilot_sd_day"], math.sqrt(28/3))
+        self.assertEqual(summary["sample_variance_denominator"], "K_MINUS_1")
+        self.assertEqual(summary["unit"], "PAIRED_DAY_MEANS_EQUAL_WEIGHT")
