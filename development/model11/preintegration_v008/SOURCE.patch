+            return {**output, "status": "UNVERIFIED_INFINITE_LOGLOSS", "reason_codes": ["OBSERVED_OUTCOME_HAS_ZERO_PROBABILITY"], "nonfinite_logloss": "POSITIVE_INFINITY", "loss_is_finite": False}
