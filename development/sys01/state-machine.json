      "from": "PREPARE_WRITE",
      "to": "STOP_GUARD",
      "event": "existing deadline/GO/frozen/attempt guard fails or unknown"
    },
    {
      "id": "e08",
      "from": "PREPARE_WRITE",
      "to": "WRITE_REQUESTED",
      "event": "all INITIAL guards satisfied in proposed design"
    },
    {
