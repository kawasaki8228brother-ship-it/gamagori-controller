    },
    {
      "id": "e16",
      "from": "RECONCILE",
      "to": "READBACK",
      "event": "exactly one candidate requiring raw readback"
    },
    {
      "id": "e17",
      "from": "RECONCILE",
      "to": "HOLD_DUPLICATE",
      "event": "duplicate records, identical or conflicting bytes"
    },
    {
      "id": "e18",
      "from": "RECONCILE",
      "to": "HOLD_PARTIAL",
      "event": "partial record(s), not a valid complete readback"
    },
    {
      "id": "e19",
      "from": "RECONCILE",
      "to": "HOLD_SAFETY_BLOCK",
      "event": "safety-block and no exact persisted confirmation"
    },
    {
      "id": "e20",
      "from": "RECONCILE",
      "to": "HOLD_INFLIGHT",
      "event": "zero records but original write not proven settled"
    },
    {
      "id": "e21",
      "from": "RECONCILE",
      "to": "RETRY_GUARDS",
      "event": "zero records, request settled, no unresolved safety block"
    },
    {
      "id": "e22",
      "from": "READBACK",
      "to": "CONFIRMED",
      "event": "one scoped raw/hash exact record, no safety event"
    },
    {
      "id": "e23",
      "from": "READBACK",
      "to": "HOLD_SAFETY_PERSISTED",
      "event": "persistence exact but safety event remains open"
    },
    {
      "id": "e24",
      "from": "READBACK",
      "to": "HOLD_CONFLICT",
      "event": "same key but different raw bytes/hash"
    },
    {
      "id": "e25",
      "from": "READBACK",
      "to": "HOLD_SCOPE",
      "event": "wrong source/race/key identity; do not inspect other-source prediction"
    },
    {
      "id": "e26",
      "from": "READBACK",
      "to": "HOLD_PARTIAL",
      "event": "raw bytes/hash/required fields missing"
    },
    {
      "id": "e27",
      "from": "READBACK",
      "to": "HOLD_READBACK",
      "event": "candidate disappeared or readback failed"
    },
    {
      "id": "e28",
      "from": "RETRY_GUARDS",
      "to": "STOP_GUARD",
      "event": "retry GO/deadline/original identity/bytes/counter fails or unknown"
    },
    {
      "id": "e29",
      "from": "RETRY_GUARDS",
      "to": "HOLD_DEDUP",
      "event": "atomic key uniqueness/idempotent sink guarantee unproven"
    },
    {
      "id": "e30",
      "from": "RETRY_GUARDS",
      "to": "RETRY_DESIGN_ELIGIBLE",
      "event": "all explicit exact-retry guards satisfied; no runtime implementation"
    },
    {
      "id": "e31",
      "from": "RETRY_DESIGN_ELIGIBLE",
      "to": "WRITE_REQUESTED",
      "event": "separately authorized SAME bytes/key once, synthetic design only"
    },
    {
      "id": "e32",
      "from": "START",
      "to": "STOP_GUARD",
      "event": "scoped read GO absent/unknown; do not query"
    },
    {
      "id": "e33",
      "from": "PREPARE_WRITE",
      "to": "HOLD_DEDUP",
      "event": "initial atomic uniqueness guarantee unproven; no search-then-create race claim"
    }
  ],
  "retry_policy_status": "PROPOSED_NOT_ADOPTED",
  "proposed_max_total_attempts": 2,
