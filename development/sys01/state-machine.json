      "event": "SAFETY_BLOCK"
    },
    {
      "id": "e13",
      "from": "WRITE_REQUESTED",
      "to": "RECONCILE",
      "event": "CONNECTION_FAILURE"
    },
    {
      "id": "e14",
      "from": "WRITE_REQUESTED",
      "to": "RECONCILE",
      "event": "UNKNOWN_RESPONSE"
    },
    {
      "id": "e15",
      "from": "RECONCILE",
