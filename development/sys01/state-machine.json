      "to": "HOLD_DUPLICATE",
      "event": "more than one matching key record"
    },
    {
      "id": "e06",
      "from": "PRECHECK",
      "to": "PREPARE_WRITE",
      "event": "authoritative complete search: zero records"
    },
    {
