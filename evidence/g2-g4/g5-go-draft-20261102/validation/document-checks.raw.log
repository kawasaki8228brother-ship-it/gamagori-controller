ENV {"openssl": "OpenSSL 3.5.8 25 Aug 2026", "os": "Linux", "purpose": "DOCUMENT_VALIDATION_ONLY_NOT_APPLICATION_RUNTIME", "python": "3.12.14"}
SOURCE_COMMAND_HASHES 6_MATCH
PAYLOAD_END_TOKENS 6_MATCH
ASCII_ONE_LINE_NO_LF 6_MATCH
P1_P9_COVERAGE 9_PRESENT
LIVE_APPROVALS NONE
RENDER_OPERATIONS NONE
RAW_COMMAND_EXECUTIONS NONE
NOMINAL_TASK_TRIGGER_COLLISIONS W60=0 W45=0 LIVE_STATUS=UNKNOWN
VALIDATION_COMPLETE DOCUMENT_ONLY
