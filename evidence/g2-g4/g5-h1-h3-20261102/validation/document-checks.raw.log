ENV {"openssl": "OpenSSL 3.5.8 25 Aug 2026", "os": "Linux", "purpose": "LOCAL_DOCUMENT_VALIDATION_NOT_APPLICATION_RUNTIME", "python": "3.12.14"}
PRIVATE_AUDIT 6312_BYTES_SHA_MATCH_RAW_NOT_PUBLISHED
PARENT_G5_DOCUMENTS BYTE_AND_GIT_BLOB_MATCH
RAW_CATALOGS 3_BYTE_UNCHANGED
SOURCE_COMMANDS 6_BYTES_SHA_GIT_BLOB_ASCII_END_TOKEN_MATCH_NOT_EXECUTED
COVERAGE P1_P9=9 H1_H3=3 R1_R5=5
N1_N3 NONRACE_LIMITED_CONTRACT N4_DEFERRED_UNOBSERVED
E07 OPERATIONAL_CONTRACT PROCESS_IDENTITY_UNVERIFIED_ANDY_DECISION_PENDING
E08_E10 OPTIONAL_NOT_ADDITIONAL_GATES A1_A3_DUPLICATE_OMISSION_CONDITIONAL
DB_IDENTITY FIXED_PATH_ACTUAL_SERVICE_MOUNT_CURRENT_STARTUP_REQUIRED_LIVE_UNVERIFIED
GO1_GO2 UNSIGNED_PER_ACTION TARGET_SHA_METHOD_ACTOR_STOP_REQUIRED
MERGE_START MINIMUM_REMAINING_30_MINUTES W60_CANDIDATE_UNAPPROVED
TASKS NOMINAL_COLLISIONS_W60=0_W45=0 ACTUAL_STATUS_UNKNOWN
REQUIREMENTS 340_BYTES_19_LINES_SHA_GIT_BLOB_MATCH_NOT_CHANGED
RENDER_OPERATIONS NONE RAW_COMMAND_EXECUTIONS NONE APP_IMPORTS NONE
VALIDATION_COMPLETE DOCUMENT_ONLY NOT_RUNTIME_PASS GO_FALSE
